# Without this the build context is gigabytes: `target/` alone dwarfs the source
# by three orders of magnitude, and every byte is sent to the daemon before the
# build starts.

target/
**/target/
node_modules/
**/node_modules/
dist/
**/dist/

# Generated by Tauri from tauri.conf.json and the capability files.
apps/desktop/src-tauri/gen/

# Its own workspace, and not part of the server build.
fuzz/

.git/
.github/
examples/

# Runtime state. Never copy a local server's identity into an image.
/run
*.key
*.identity
known_servers.json
*.db
*.db-journal

.env
.env.local
.DS_Store
