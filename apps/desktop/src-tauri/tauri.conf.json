{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pickle",
  "version": "0.1.0",
  "identifier": "dev.pickle.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pickle",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "dmg"],
    "icon": ["icons/icon.png"],
    "category": "SocialNetworking",
    "shortDescription": "Self-hosted voice and text chat",
    "longDescription": "Self-hosted voice and text chat. You run the server, you own the data, and a user is an Ed25519 keypair rather than an account.",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libasound2"
        ]
      }
    }
  }
}
