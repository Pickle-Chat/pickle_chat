# Copy to `.env` and edit. `.env` is gitignored; this file is not.
#
# Generate something long rather than choosing it:
#
#   openssl rand -base64 32
#
# Anything able to read the containers' environment can read this — `docker
# inspect` suffices — so it protects against a leaked repository, not against
# someone already on the host.
POSTGRES_PASSWORD=change-me
